NODE_ENV=development
PORT=3000
# Local PostgreSQL (not Docker). Create DB first: createdb convertly
# Vitest (NODE_ENV=test) uses convertly_test on the same server; the DB is created automatically.
DATABASE_URL=postgresql://localhost:5432/convertly
JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGIN=http://127.0.0.1:5173
STORAGE_ROOT=storage
# Production (Northflank): listen on all interfaces and serve the Vite build.
# LISTEN_HOST=0.0.0.0
# WEB_DIST=/app/web-dist
# TYPEORM_SYNCHRONIZE=true
# DOCX↔PDF: Docker-образ из docker compose build libreoffice. PostgreSQL — локально, не Compose.
LIBREOFFICE_DOCKER_IMAGE=convertly-libreoffice:local
# Живой бот: токен от @BotFather. Пусто — mock (тесты и dev без Telegram).
TELEGRAM_BOT_TOKEN=
