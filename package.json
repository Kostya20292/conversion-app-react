{
  "name": "convertly",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "bash scripts/with-postgres.sh bash scripts/with-libreoffice.sh turbo run dev",
    "dev:api": "bash scripts/with-postgres.sh bash scripts/with-libreoffice.sh turbo run dev --filter=@convertly/api",
    "libreoffice:build": "docker compose build libreoffice",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "preview": "pnpm --filter @convertly/web preview",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:e2e": "pnpm --filter @convertly/web test:e2e"
  },
  "devDependencies": {
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12"
  }
}
