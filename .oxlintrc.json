{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "import",
    "jsx-a11y",
    "promise",
    "vitest"
  ],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/coverage/**",
    "**/playwright-report/**",
    "**/test-results/**",
    "/storage/**",
    "apps/api/dist/**"
  ],
  "env": {
    "browser": true,
    "es2024": true
  },
  "settings": {
    "react": {
      "version": "19.2.8",
      "linkComponents": [
        { "name": "Link", "linkAttribute": "to" },
        { "name": "NavLink", "linkAttribute": "to" }
      ]
    },
    "jsx-a11y": {
      "components": {
        "Button": "button",
        "Link": "a",
        "NavLink": "a"
      }
    }
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "react/no-danger": "error",
    "react/react-compiler": "warn",
    "typescript/no-explicit-any": "error",
    "import/no-cycle": "error",
    "import/no-relative-parent-imports": "error",
    "jsx-a11y/anchor-is-valid": [
      "error",
      {
        "components": ["Link", "NavLink"],
        "specialLink": ["to"]
      }
    ],
    "jsx-a11y/control-has-associated-label": "off",
    "jsx-a11y/prefer-tag-over-role": "off"
  },
  "overrides": [
    {
      "files": [
        "**/*.config.{ts,js,mjs,cjs}",
        "**/playwright.config.ts",
        "**/vite.config.ts",
        "**/vitest.config.ts",
        "**/vitest.config.mts"
      ],
      "env": {
        "node": true
      }
    },
    {
      "files": ["apps/api/**/*.ts"],
      "env": {
        "node": true
      },
      "rules": {
        "react/rules-of-hooks": "off",
        "react/only-export-components": "off",
        "react/no-danger": "off",
        "react/react-compiler": "off"
      }
    },
    {
      "files": ["**/*.{test,spec}.{ts,tsx}"],
      "rules": {
        "vitest/no-disabled-tests": "warn",
        "vitest/warn-todo": "warn",
        "vitest/require-to-throw-message": "off"
      }
    },
    {
      "files": ["apps/web/src/components/**/*.{ts,tsx}", "src/components/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@/(pages|features|api|app)(/|$)",
                "message": "components не зависят от pages, features, api и app. Общее — в lib, types или constants."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/lib/**/*.{ts,tsx}", "src/lib/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@/(pages|components|features|api|app)(/|$)",
                "message": "lib — чистые утилиты: только types, constants и другие модули lib."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/features/**/*.{ts,tsx}", "src/features/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@/(pages|components|app)(/|$)",
                "message": "features не зависят от UI-слоя (pages, components, app)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/api/**/*.{ts,tsx}", "src/api/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@/(pages|components|features|app)(/|$)",
                "message": "api — тонкий HTTP-слой без UI и Zustand."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/pages/**/*.{ts,tsx}", "src/pages/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@/pages(/|$)",
                "message": "Страницы не импортируют другие страницы. Общее — в components, features или lib."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/types/**/*.{ts,tsx}", "src/types/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@/(pages|components|features|api|app|lib|constants)(/|$)",
                "message": "types не зависят от UI, фич и constants."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/constants/**/*.{ts,tsx}", "src/constants/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@/(pages|components|features|api|app|lib)(/|$)",
                "message": "constants могут импортировать только types."
              }
            ]
          }
        ]
      }
    }
  ]
}
